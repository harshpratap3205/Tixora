# ============================================================================
# TIXORA V1 — ENVIRONMENT CONFIGURATION TEMPLATE (Node.js + Express + Next.js)
# Copy this file to .env for Docker Compose or local development
# ============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL Database ---
# Leave DATABASE_URL blank in local development to automatically use embedded PostgreSQL (PGlite)
# or set DATABASE_URL to connect to a live PostgreSQL 16/17 server:
DATABASE_URL=postgresql://tixora:3205@localhost:5432/tixora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tixora
POSTGRES_USER=tixora
POSTGRES_PASSWORD=3205

# --- Authentication & Security ---
JWT_ACCESS_SECRET=tixora_v1_production_grade_hmac_sha256_access_secret_key_2026
JWT_REFRESH_SECRET=tixora_v1_production_grade_hmac_sha256_refresh_secret_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7
QR_SIGNING_SECRET=tixora_v1_qr_ticket_hmac_sha256_verification_secret_key_2026

# --- Reservation & Payment Engine ---
HOLD_DURATION_SECONDS=480
TURNAROUND_MINUTES=20
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=whsec_tixora_sandbox_signature_secret_2026

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
