{
  "name": "tixora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tixora — Production-Minded Movie Ticket Booking Platform (Next.js + Node.js/Express + PostgreSQL)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "start": "node scripts/start.js",
    "start:api": "npm --workspace=@tixora/api run start",
    "start:web": "npm --workspace=@tixora/web run start",
    "dev:api": "npm --workspace=@tixora/api run dev",
    "dev:web": "npm --workspace=@tixora/web run dev",
    "build:api": "npm --workspace=@tixora/api run build",
    "build:web": "npm --workspace=@tixora/web run build",
    "build": "npm run build:api && npm run build:web",
    "test:api": "npm --workspace=@tixora/api run test",
    "test": "npm run test:api"
  }
}
